# Copia este archivo a ".env" y ajusta los valores.
# Genera una SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-me-please

# Base de datos. Por defecto SQLite dentro de instance/.
# Para PostgreSQL usa por ejemplo:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/onoff
DATABASE_URL=sqlite:///instance/onoff.db

# Carpeta de subidas (por defecto instance/uploads)
# UPLOAD_FOLDER=instance/uploads

# Tamano maximo por peticion en bytes (por defecto 16 MB)
MAX_CONTENT_LENGTH=16777216

# Credenciales del primer superadmin creado por "flask seed"
ADMIN_EMAIL=admin@wearonoff.com
ADMIN_PASSWORD=cambiar-esta-clave
ADMIN_NAME=Administrador

# Solo produccion: cookies seguras
SESSION_COOKIE_SECURE=false
