---
interface Props {
  marca?: string;
}

const { marca = 'WearOnOff' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wearonoff-footer">
  <div class="wearonoff-container">
    <div class="wearonoff-footer__grid">
      <div>
        <h4>Obtén ayuda</h4>
        <ul>
          <li><a href="#preguntas">Centro de ayuda</a></li>
          <li><a href="#preguntas">Envío y entregas</a></li>
          <li><a href="#preguntas">Devoluciones y cambios</a></li>
          <li><a href="mailto:hola@wearonoff.com">Contáctanos</a></li>
        </ul>
      </div>
      <div>
        <h4>Nuestra empresa</h4>
        <ul>
          <li><a href="#historia">Nuestra historia</a></li>
        </ul>
      </div>
      <div>
        <h4>Guías</h4>
        <ul>
          <li><a href="#preguntas">Guía de tallas</a></li>
          <li><a href="#preguntas">Cuidado de la prenda</a></li>
          <li><a href="#telas">Materiales</a></li>
          <li><a href="#preguntas">Personaliza tu uniforme</a></li>
        </ul>
      </div>
      <div>
        <h4>Más información</h4>
        <ul>
          <li><a href="#equipo">Pedidos grupales</a></li>
          <li><a href="#estudiantes">Descuento para estudiantes</a></li>
          <li><a href="#preguntas">Preguntas frecuentes</a></li>
        </ul>
      </div>
    </div>
    <div class="wearonoff-footer__bottom">
      <span>&copy; {year} {marca.toUpperCase()}. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
