---
interface Props {
  marca?: string;
}

const { marca = 'WearOnOff' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="wearonoff-footer">
  <div class="wearonoff-container">
    <div class="wearonoff-footer__grid">
      <div>
        <h4>Obtén ayuda</h4>
        <ul>
          <li><a href="#contacto">Centro de ayuda</a></li>
          <li><a href="#contacto">Envío y entregas</a></li>
          <li><a href="#contacto">Devoluciones y cambios</a></li>
          <li><a href="#contacto">Contáctanos</a></li>
        </ul>
      </div>
      <div>
        <h4>Nuestra empresa</h4>
        <ul>
          <li><a href="https://wearonoff.com">Nuestra historia</a></li>
          <li><a href="https://wearonoff.com">Portafolio</a></li>
          <li><a href="https://wearonoff.com">Impacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Guías</h4>
        <ul>
          <li><a href="#productos">Guía de tallas</a></li>
          <li><a href="#productos">Cuidado de la prenda</a></li>
          <li><a href="#telas">Materiales</a></li>
          <li><a href="#productos">Personaliza tu uniforme</a></li>
        </ul>
      </div>
      <div>
        <h4>Más información</h4>
        <ul>
          <li><a href="#equipo">Pedidos grupales</a></li>
          <li><a href="#productos">Descuento para estudiantes</a></li>
          <li><a href="#contacto">Preguntas frecuentes</a></li>
          <li><a href="#contacto">Trabaja con nosotros</a></li>
        </ul>
      </div>
    </div>
    <div class="wearonoff-footer__bottom">
      <span>&copy; {year} {marca.toUpperCase()}. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
