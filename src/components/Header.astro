---
interface Props {
  marca?: string;
  anuncioTexto?: string;
  anuncioEnlace?: string;
  anuncioEnlaceTexto?: string;
}

const {
  marca = 'Scrubs',
  anuncioTexto = '',
  anuncioEnlace = '#colores',
  anuncioEnlaceTexto = 'Compra ahora',
} = Astro.props;
---

<div class="figs-announce">
  <span class="figs-announce__long">{anuncioTexto}<span class="figs-announce__sep">·</span></span>
  <a href={anuncioEnlace}>{anuncioEnlaceTexto}</a>
</div>

<header class="figs-header">
  <div class="figs-container figs-header__inner">
    <button
      class="figs-icon-btn figs-menu-toggle"
      type="button"
      data-figs-open
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <nav class="figs-header__nav" aria-label="Principal">
      <a href="#mujeres">Mujeres</a>
      <a href="#hombres">Hombres</a>
      <a href="#colores">Colores</a>
      <a href="#telas">Telas</a>
      <a href="#equipo">Equipos</a>
    </nav>

    <a class="figs-logo" href="/" aria-label="ON & OFF">
      <img src="/images/logo-onoff.svg" alt="ON & OFF" />
    </a>

    <div class="figs-header__actions">
      <button class="figs-icon-btn" type="button" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
      <a class="figs-icon-btn" href="#" aria-label="Mi cuenta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 21a8 8 0 0 1 16 0"></path>
        </svg>
      </a>
      <a class="figs-icon-btn figs-bag" href="#productos" aria-label="Bolsa de compras">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="figs-bag__count">0</span>
      </a>
    </div>
  </div>
</header>

<div class="figs-drawer" data-figs-drawer>
  <div class="figs-drawer__top">
    <span class="figs-logo">
      <img src="/images/logo-onoff.svg" alt="ON & OFF" />
    </span>
    <button class="figs-icon-btn" type="button" data-figs-close aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <nav class="figs-drawer__nav" aria-label="Móvil">
    <a href="#mujeres">Mujeres</a>
    <a href="#hombres">Hombres</a>
    <a href="#colores">Colores</a>
    <a href="#telas">Telas</a>
    <a href="#equipo">Equipos</a>
    <a href="#productos">Comprar</a>
  </nav>
</div>
