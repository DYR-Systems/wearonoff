---
interface Props {
  marca?: string;
  anuncioTexto?: string;
  anuncioEnlace?: string;
  anuncioEnlaceTexto?: string;
}

const {
  marca = 'WearOnOff',
  anuncioTexto = '',
  anuncioEnlace = '#colores',
  anuncioEnlaceTexto = 'Compra ahora',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const home = path === '/' ? '' : '/';
---

<div class="wearonoff-announce">
  <span class="wearonoff-announce__long">{anuncioTexto}<span class="wearonoff-announce__sep">·</span></span>
  <a href={anuncioEnlace}>{anuncioEnlaceTexto}</a>
</div>

<header class="wearonoff-header">
  <div class="wearonoff-container wearonoff-header__inner">
    <button
      class="wearonoff-icon-btn wearonoff-menu-toggle"
      type="button"
      data-wearonoff-open
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <nav class="wearonoff-header__nav" aria-label="Principal">
      <a href={`${home}#productos`}>Tienda</a>
      <a href={`${home}#mujeres`}>Mujeres</a>
      <a href={`${home}#hombres`}>Hombres</a>
      <a href={`${home}#colores`}>Colores</a>
      <a href={`${home}#historia`}>Nuestra historia</a>
      <a href={`${home}#equipo`}>Pedidos grupales</a>
    </nav>

    <a class="wearonoff-logo" href="/" aria-label="WEARONOFF">
      <img class="wearonoff-logo__mark" src="/images/logo-mark.svg" alt="" aria-hidden="true" />
      <span>WEARONOFF</span>
    </a>

    <div class="wearonoff-header__actions">
      <div class="wearonoff-lang wearonoff-lang--header" role="group" aria-label="Idioma">
        <button class="wearonoff-lang__btn is-active" type="button" data-lang="es" aria-pressed="true">ES</button>
        <span class="wearonoff-lang__sep" aria-hidden="true">/</span>
        <button class="wearonoff-lang__btn" type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <button class="wearonoff-icon-btn" type="button" aria-label="Buscar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
      <button
        class="wearonoff-icon-btn wearonoff-bag"
        type="button"
        data-cart-open
        aria-label="Abrir carrito"
        aria-controls="wearonoff-cart"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="wearonoff-bag__count" data-cart-count>0</span>
      </button>
    </div>
  </div>
</header>

<div class="wearonoff-drawer" data-wearonoff-drawer>
  <div class="wearonoff-drawer__top">
    <span class="wearonoff-logo">
      <img class="wearonoff-logo__mark" src="/images/logo-mark.svg" alt="" aria-hidden="true" />
      <span>WEARONOFF</span>
    </span>
    <button class="wearonoff-icon-btn" type="button" data-wearonoff-close aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <div class="wearonoff-drawer__lang">
    <span>Idioma</span>
    <div class="wearonoff-lang" role="group" aria-label="Idioma">
      <button class="wearonoff-lang__btn is-active" type="button" data-lang="es" aria-pressed="true">ES</button>
      <span class="wearonoff-lang__sep" aria-hidden="true">/</span>
      <button class="wearonoff-lang__btn" type="button" data-lang="en" aria-pressed="false">EN</button>
    </div>
  </div>
  <nav class="wearonoff-drawer__nav" aria-label="Móvil">
    <a href={`${home}#productos`}>Tienda</a>
    <a href={`${home}#mujeres`}>Mujeres</a>
    <a href={`${home}#hombres`}>Hombres</a>
    <a href={`${home}#colores`}>Colores</a>
    <a href={`${home}#historia`}>Nuestra historia</a>
    <a href={`${home}#equipo`}>Pedidos grupales</a>
  </nav>
</div>
