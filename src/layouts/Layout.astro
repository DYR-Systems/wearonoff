---
import '../styles/figs.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'WearOnOff — Uniformes médicos con estilo',
  description = 'Uniformes médicos con estilo. Comodidad, materiales de calidad y diseño para quienes trabajan sin descanso.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="figs">
    <slot />
    <script src="/js/figs.js" defer></script>
  </body>
</html>
